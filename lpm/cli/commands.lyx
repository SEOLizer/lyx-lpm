}

// ---------------------------------------------------------------------------
// lpm init — schreibt lyx.toml direkt (ohne Manifest-Klasse, kein Alloc-Problem)
// ---------------------------------------------------------------------------

fn lpmInit(ctx: LpmCtx): int64 {
  if FileExists("lyx.toml"c) {
    cmdErr("lyx.toml existiert bereits in diesem Verzeichnis."c);
    return 1;
  }

  var pkgName: pchar := ctx.LcFlagVal("--name"c);
  if pkgName == 0 as pchar { pkgName := ctx.LcSubArg(0); }
  if pkgName == 0 as pchar { pkgName := "mypackage"c; }

  var tbuf: int64 := alloc(2048);
  var pos: int64 := 0;
  pos := cmdWrS(tbuf, pos, "[package]\n"c);
  pos := cmdWrS(tbuf, pos, "name        = \""c);
  pos := cmdWrS(tbuf, pos, pkgName);
  pos := cmdWrS(tbuf, pos, "\"\n"c);
  pos := cmdWrS(tbuf, pos, "version     = \"0.1.0\"\n"c);
  pos := cmdWrS(tbuf, pos, "author      = \"\"\n"c);
  pos := cmdWrS(tbuf, pos, "license     = \"MIT\"\n"c);
  pos := cmdWrS(tbuf, pos, "description = \"\"\n"c);
  pos := cmdWrS(tbuf, pos, "\n[build]\n"c);
  pos := cmdWrS(tbuf, pos, "entry       = \"main.lyx\"\n"c);

  var wfd: int64 := open("lyx.toml"c, 577, 420);  // O_WRONLY|O_CREAT|O_TRUNC, 0644
  if wfd < 0 {
    cmdErr("Konnte lyx.toml nicht schreiben."c);
    free(tbuf, 2048);
    return 1;
  }
  sys_write(wfd, tbuf, pos);
  close(wfd);
  free(tbuf, 2048);

  cmdOut("lpm: Paket '"c);
  cmdOut(pkgName);
  cmdOutLn("' initialisiert."c);
  cmdOutLn("lpm: lyx.toml wurde erstellt."c);
  return 0;
}

// ---------------------------------------------------------------------------
// lpm cache list
// ---------------------------------------------------------------------------

fn lpmCacheList(argc: int64, argv: pchar): int64 {
  var home: pchar := cmdGetHome(argc, argv);
  return LpmCacheListCmd(home);
}

// ---------------------------------------------------------------------------
// lpm cache clean
// ---------------------------------------------------------------------------

fn lpmCacheClean(argc: int64, argv: pchar): int64 {
  var home: pchar := cmdGetHome(argc, argv);
  return LpmCacheCleanCmd(home);
}

// ---------------------------------------------------------------------------
// Stubs für netzwerkabhängige Befehle
// ---------------------------------------------------------------------------

fn lpmNotImpl(cmd: pchar): int64 {
  cmdOut("lpm: '"c);
  cmdOut(cmd);
  cmdOutLn("' ist noch nicht implementiert (Netzwerk-WPs folgen)."c);
  return 1;
}

// ---------------------------------------------------------------------------
// Dispatch
// ---------------------------------------------------------------------------

pub fn lpmDispatch(ctx: LpmCtx, argc: int64, argv: pchar): int64 {
  var cmd: pchar := ctx.LcSubcmd();
  if cmd == 0 as pchar {
    lpmHelp();
    return 1;
  }

  if StrCmp(cmd, "init"c)    == 0 { return lpmInit(ctx); }
  if StrCmp(cmd, "install"c) == 0 { return lpmNotImpl("install"c); }
  if StrCmp(cmd, "remove"c)  == 0 { return lpmNotImpl("remove"c); }
  if StrCmp(cmd, "update"c)  == 0 { return lpmNotImpl("update"c); }
  if StrCmp(cmd, "search"c)  == 0 { return lpmNotImpl("search"c); }
  if StrCmp(cmd, "info"c)    == 0 { return lpmNotImpl("info"c); }
  if StrCmp(cmd, "list"c)    == 0 { return lpmNotImpl("list"c); }
  if StrCmp(cmd, "publish"c) == 0 { return lpmNotImpl("publish"c); }
  if StrCmp(cmd, "login"c)   == 0 { return lpmNotImpl("login"c); }
  if StrCmp(cmd, "resolve"c) == 0 { return lpmNotImpl("resolve"c); }

  if StrCmp(cmd, "cache"c) == 0 {
    // Achtung: && schliesst hier nicht kurz — Null-Check muss geschachtelt sein.
    var sub: pchar := ctx.LcSubArg(0);
    if sub != 0 as pchar {
      if StrCmp(sub, "list"c)  == 0 { return lpmCacheList(argc, argv); }
      if StrCmp(sub, "clean"c) == 0 { return lpmCacheClean(argc, argv); }
    }
    cmdOutLn("lpm cache: Subcommand erwartet: list | clean"c);
    return 1;
  }

  cmdOut("lpm: unbekannter Befehl '"c);
  cmdOut(cmd);
  cmdOutLn("'. Siehe: lpm --help"c);
  return 1;
}

// ---------------------------------------------------------------------------
// Einstiegspunkt — wird von main.lyx aufgerufen
// ---------------------------------------------------------------------------

pub fn lpmMain(argc: int64, argv: pchar): int64 {
  if argc < 2 {
    lpmHelp();
    return 1;
  }

  // Globale Flags zuerst prüfen (vor LpmCtx — einfache lineare Suche)
  var i: int64 := 1;
  while i < argc {
    var arg: pchar := ArgvGet(argv, i);
    if StrCmp(arg, "--help"c) == 0 || StrCmp(arg, "-h"c) == 0 {
      lpmHelp(); return 0;
    }
    if StrCmp(arg, "--version"c) == 0 || StrCmp(arg, "-V"c) == 0 {
      lpmVersion(); return 0;
    }
    i := i + 1;
  }

  var ctx: LpmCtx := new LpmCtx();
  ctx.LcInit(argc, argv);
  var result: int64 := lpmDispatch(ctx, argc, argv);
  dispose ctx;
  return result;
}
